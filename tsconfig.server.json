{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "outDir": "dist", "rootDir": "src",
    "rewriteRelativeImportExtensions": true, "allowImportingTsExtensions": true, "types": ["node"]
  },
  "include": ["src/server", "src/shared"]
}
