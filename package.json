{
  "name": "inkwell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "corpus": "node scripts/corpus/run.mjs",
    "rehearse": "node scripts/rehearsal/run.mjs",
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.80",
    "@hocuspocus/provider": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@hocuspocus/transformer": "4.8.0",
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.105.0",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-collaboration": "3.32.1",
    "@tiptap/extension-collaboration-caret": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1",
    "@tiptap/y-tiptap": "3.0.11",
    "ai": "7.0.156",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.17",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.14",
    "lucide-react": "1.64.0",
    "marked": "18.1.2",
    "nanoid": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "ws": "8.22.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "jsdom": "29.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
