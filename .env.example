# Meta Model API (https://dev.meta.ai/docs/quickstart). OpenAI-compatible.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Agents' brain. Note: tool_choice only accepts "auto" on this API.
META_TEXT_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_SEGMENT_MODEL=sam-3.1
PORT=8787
DATA_DIR=./data
